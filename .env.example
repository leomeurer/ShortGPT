# LLM API Keys (configure at least one)
# Priority order: Groq -> Gemini -> OpenAI

# Groq (Fastest, recommended)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini
# Get your key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Text-to-Speech
# ElevenLabs (optional, for premium voices)
# Get your key at: https://elevenlabs.io/api
ELEVENLABS_API_KEY=

# Stock Media
# Pexels (for stock images/videos)
# Get your key at: https://www.pexels.com/api/
PEXELS_API_KEY=